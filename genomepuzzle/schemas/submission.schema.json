{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghrupuzzles.org/schemas/genomepuzzle/submission-2.1.json",
  "title": "GenomePuzzle submission definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "exercise", "mode", "fields"],
  "properties": {
    "schema_version": { "const": "2.1" },
    "release_id": { "type": "string", "minLength": 1 },
    "exercise": { "enum": ["typing", "assembly", "hybrid", "outbreak"] },
    "mode": { "enum": ["practice", "challenge"] },
    "fields": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "label",
          "description",
          "type",
          "required",
          "identifier",
          "scored",
          "scorer",
          "aliases",
          "normalizer"
        ],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "type": { "const": "string" },
          "required": { "type": "boolean" },
          "identifier": { "type": "boolean" },
          "scored": { "type": "boolean" },
          "scorer": {
            "enum": ["identifier", "exact", "unordered_list", "partition"]
          },
          "aliases": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "uniqueItems": true
          },
          "normalizer": {
            "enum": [
              "identifier",
              "integer",
              "qc_status",
              "sequence_type",
              "species",
              "trim",
              "trim_casefold",
              "unordered_list",
              "upper"
            ]
          },
          "allowed_values": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "required_when": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "equals"],
            "properties": {
              "field": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "equals": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
